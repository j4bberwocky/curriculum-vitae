<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ personal.name }} — CV</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
<main>
  <header>
    <h1>{{ personal.name }}</h1>
    {% if personal.title %}<p class="title">{{ personal.title }}</p>{% endif %}
    <p class="contact">
      {% if personal.phone %}<span>{{ personal.phone }}</span>{% endif %}
      {% if personal.email %}<a href="mailto:{{ personal.email }}">{{ personal.email }}</a>{% endif %}
      {% if personal.github %}<a href="https://{{ personal.github }}">{{ personal.github }}</a>{% endif %}
      {% if personal.linkedin %}<a href="https://{{ personal.linkedin }}">{{ personal.linkedin }}</a>{% endif %}
    </p>
  </header>

  {% if summary %}
  <section>
    <h2>Summary</h2>
    <p>{{ summary }}</p>
  </section>
  {% endif %}

  {% if experiences %}
  <section>
    <h2>Experience</h2>
    {% for exp in experiences %}
    <article>
      <h3>{{ exp.role }} — {{ exp.company }}</h3>
      <p class="meta">
        {% if exp.location %}{{ exp.location }} · {% endif %}{{ exp.start_date }} – {{ exp.end_date }}
      </p>
      {% if exp.responsibilities %}
      <ul>
        {% for r in exp.responsibilities %}<li>{{ r }}</li>{% endfor %}
      </ul>
      {% endif %}
    </article>
    {% endfor %}
  </section>
  {% endif %}

  {% if education %}
  <section>
    <h2>Education</h2>
    {% for edu in education %}
    <article>
      <h3>{{ edu.degree }}</h3>
      <p class="meta">{{ edu.institution }} · {{ edu.date }}</p>
    </article>
    {% endfor %}
  </section>
  {% endif %}

  {% if skills %}
  <section>
    <h2>Skills</h2>
    <ul class="skills">
      {% for s in skills %}<li><span class="topic">{{ s.topic }}</span> {{ s.description }}</li>{% endfor %}
    </ul>
  </section>
  {% endif %}

  <footer class="page-footer">
    <a class="pdf-link" href="tommaso-cortonesi-cv.pdf">Download PDF</a>
    <span class="sep">·</span>
    v{{ version }} — {{ build_date }}
  </footer>
</main>
</body>
</html>
