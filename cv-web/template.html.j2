<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ personal.name }} — CV</title>
</head>
<body>
  <header>
    <h1>{{ personal.name }}</h1>
    <p>{{ personal.title }}</p>
    <p><a href="mailto:{{ personal.email }}">{{ personal.email }}</a></p>
  </header>

  <section>
    <h2>Summary</h2>
    <p>{{ summary }}</p>
  </section>

  <section>
    <h2>Experience</h2>
    {% for exp in experiences %}
    <article>
      <h3>{{ exp.role }} — {{ exp.company }}</h3>
      <p>
        {% if exp.location %}{{ exp.location }} · {% endif %}{{ exp.start_date }} – {{ exp.end_date }}
      </p>
      {% if exp.responsibilities %}
      <ul>
        {% for r in exp.responsibilities %}<li>{{ r }}</li>{% endfor %}
      </ul>
      {% endif %}
    </article>
    {% endfor %}
  </section>

  <section>
    <h2>Education</h2>
    {% for edu in education %}
    <article>
      <h3>{{ edu.degree }}</h3>
      <p>{{ edu.institution }} · {{ edu.date }}</p>
    </article>
    {% endfor %}
  </section>

  <section>
    <h2>Skills</h2>
    <ul>
      {% for s in skills %}<li><strong>{{ s.topic }}</strong>: {{ s.description }}</li>{% endfor %}
    </ul>
  </section>
</body>
</html>
